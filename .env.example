DATABASE_URL="postgresql://user:password@localhost:5432/aramway?schema=public"
# Must match AramwayDashboard's JWT_SECRET exactly — the dashboard verifies
# the session JWT this backend issues on login.
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
# CORS is intentionally open to any origin (src/app.ts) — no CORS_ORIGIN needed.

# Used to build absolute links in outbound emails (e.g. "read the full post").
FRONTEND_URL="https://aramway.com"

# SMTP credentials for outbound email (subscription confirmations, new-blog
# notifications, consultation confirmations). Works with any SMTP provider —
# Gmail, SendGrid, Mailgun, AWS SES, etc. If left unset, emails are logged to
# the console instead of sent (safe for local dev).
#
# Currently using Resend SMTP (Bluehost's shared-hosting SMTP was IP-blocking
# our app server's outbound mail — see git history for details):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=<a Resend API key with sending permission>
#   EMAIL_FROM must be an address on a domain verified in Resend.
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASS="replace-with-resend-api-key"
EMAIL_FROM="ARAMWAY GROUP <connect@aramway.com>"

# Every new consultation booking also sends an internal notification here,
# in addition to the customer's own confirmation email.
CONSULTATION_NOTIFY_EMAIL="staff@example.com"

# Generates a real, shared Google Meet link per consultation (instead of the
# static https://meet.google.com/new, which creates a NEW room every time
# it's visited — so the customer and staff never actually end up in the same
# meeting). Setup: see the comment at the top of
# scripts/get-google-refresh-token.ts, then run `npm run google:auth`.
# Until GOOGLE_REFRESH_TOKEN is set, bookings fall back to the static link.
GOOGLE_CLIENT_ID="replace-with-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-oauth-client-secret"
GOOGLE_REFRESH_TOKEN="replace-after-running-npm-run-google:auth"
# GOOGLE_CALENDAR_ID=primary
